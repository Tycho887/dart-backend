# Docker Compose injects each value only into the service that requires it.
DART_DATABASE_URL=postgresql://dart:replace-me@timescaledb:5432/dart
DART_GATEWAY_BEARER_TOKEN=replace-me
DART_INTERNAL_BEARER_TOKEN=replace-me-too
DART_OPTIMIZER_URL=http://optimizer:8001
DART_POSTPROCESSOR_URL=http://postprocessor:8002
DART_CORS_ORIGINS=http://localhost:3000
DART_AUTO_MIGRATE=true
DART_RUN_LEASE_SECONDS=1800
DART_ACQUISITION_TIMEOUT_SECONDS=120
DART_SERVICE_TIMEOUT_SECONDS=120
DART_WORKER_POLL_SECONDS=2
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-me
POSTGRES_DB=dart
POSTGRES_USER=dart
POSTGRES_PASSWORD=replace-me
DART_TIMESCALE_PORT=5433
DART_GRAFANA_PORT=3000
AZURE_ADX_CLUSTER_ENDPOINT=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
KOGS_API_KEY=
KOGS_API_BASE_URL=https://mgmt.kogs.api.ksat.no/24.08
# Optional deterministic live-test overrides. Without them, the test discovers
# the latest qualifying ADX contact and uses the legacy 2.2 GHz nominal carrier.
DART_TEST_CONTACT_ID=
DART_TEST_CARRIER_FREQUENCY_HZ=
