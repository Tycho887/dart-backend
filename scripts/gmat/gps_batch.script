% Generated by scripts/smooth_gps.py. All state units are km and km/s.
% GPS_PosVec is EarthFixed; the OEM is EarthMJ2000Eq (CCSDS EME2000).
% Mass=100 kg and area=1 m^2 normalize the estimated CdA/m; they are not
% measured FOREST spacecraft properties. No maneuvers or SRP are modeled.

Create Spacecraft Seed Sat;
Seed.DateFormat = UTCGregorian;
Seed.Epoch = '$epoch';
Seed.CoordinateSystem = EarthFixed;
Seed.DisplayStateType = Cartesian;
$seed_state
Sat.DateFormat = UTCGregorian;
Sat.Epoch = '$propagation_start';
Sat.CoordinateSystem = EarthMJ2000Eq;
Sat.DisplayStateType = Cartesian;
Sat.Id = '$satellite';
Sat.DryMass = 100;
Sat.DragArea = 1;
Sat.Cd = 2.2;
Sat.CdSigma = 100;
Sat.SolveFors = {CartesianState, Cd};
Sat.AddHardware = {GpsReceiver, GpsAntenna};

Create Antenna GpsAntenna;
Create Receiver GpsReceiver;
Create ErrorModel PosVecModel;
GpsReceiver.PrimaryAntenna = GpsAntenna;
GpsReceiver.Id = 800;
GpsReceiver.ErrorModels = {PosVecModel};
PosVecModel.Type = 'GPS_PosVec';
PosVecModel.NoiseSigma = $noise_sigma;

Create ForceModel FM;
FM.CentralBody = Earth;
FM.PrimaryBodies = {Earth};
FM.PointMasses = {Sun, Luna};
FM.GravityField.Earth.Degree = 20;
FM.GravityField.Earth.Order = 20;
FM.GravityField.Earth.PotentialFile = '$gravity_file';
FM.SRP = Off;
FM.Drag.AtmosphereModel = 'JacchiaRoberts';
FM.Drag.HistoricWeatherSource = 'CSSISpaceWeatherFile';
FM.Drag.CSSISpaceWeatherFile = '$weather_file';
FM.ErrorControl = None;

Create Propagator Prop;
Prop.FM = FM;
Prop.Type = RungeKutta89;
Prop.InitialStepSize = 30;
Prop.Accuracy = 1e-12;
Prop.MinStep = 0;
Prop.MaxStep = 60;
Prop.MaxStepAttempts = 50;

Create TrackingFileSet GPS;
GPS.FileName = {'$measurements'};
GPS.AddTrackingConfig = {{Sat.GpsReceiver}, 'GPS_PosVec'};
GPS.UseLightTime = False;
GPS.UseRelativityCorrection = False;
GPS.UseETminusTAI = True;

Create BatchEstimator BLS;
BLS.Measurements = {GPS};
BLS.Propagator = Prop;
BLS.EstimationEpochFormat = 'FromParticipants';
BLS.EstimationEpoch = 'FromParticipants';
BLS.MaximumIterations = 20;
BLS.MaxConsecutiveDivergences = 4;
BLS.AbsoluteTol = 0.00001;
BLS.RelativeTol = 0.00001;
BLS.OLSEInitialRMSSigma = 3000;
BLS.OLSEMultiplicativeConstant = 3;
BLS.OLSEAdditiveConstant = 0;
BLS.OLSEUseRMSP = False;
BLS.UseInitialCovariance = False;
BLS.ShowAllResiduals = On;
BLS.ReportFile = '$estimator_report';
BLS.DataFile = '$estimator_json';

Create ReportFile FittedState EvaluatedStates;
FittedState.Filename = '$fitted_state';
FittedState.Precision = 16;
FittedState.Delimiter = ',';
FittedState.FixedWidth = Off;
FittedState.WriteHeaders = false;
EvaluatedStates.Filename = '$evaluated_states';
EvaluatedStates.Precision = 16;
EvaluatedStates.Delimiter = ',';
EvaluatedStates.FixedWidth = Off;
EvaluatedStates.WriteHeaders = false;
EvaluatedStates.Add = {$report_fields};
EvaluatedStates.WriteReport = false;

Create EphemerisFile OEM;
OEM.Spacecraft = Sat;
OEM.Filename = '$oem';
OEM.FileFormat = CCSDS-OEM;
OEM.CoordinateSystem = EarthMJ2000Eq;
OEM.EpochFormat = UTCGregorian;
OEM.InitialEpoch = '$start';
% A 1 ms guard avoids loss of the last grid point to epoch roundoff.
OEM.FinalEpoch = '$writer_stop';
OEM.StepSize = $cadence;
OEM.Interpolator = Lagrange;
OEM.InterpolationOrder = 7;
OEM.WriteEphemeris = false;

BeginMissionSequence;
Sat.UTCModJulian = $seed_mjd;
$initialize_state
$estimation_command
Report FittedState Sat.UTCModJulian Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ Sat.Cd Sat.TAIModJulian;
% Start before the requested window to prime the ephemeris interpolation.
Propagate BackProp Prop(Sat) {Sat.UTCModJulian = $propagation_start_mjd};
Toggle OEM On;
Toggle EvaluatedStates On;
% Supply interpolation support past FinalEpoch so the endpoint is flushed.
Propagate Prop(Sat) {Sat.UTCModJulian = $stop_margin_mjd};
Toggle OEM Off;
Toggle EvaluatedStates Off;
