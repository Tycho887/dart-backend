map $http_upgrade $dart_connection_upgrade {
    default upgrade;
    '' close;
}

map $http_idempotency_key $dart_idempotency_key {
    default $http_idempotency_key;
    '' $request_id;
}

server {
    listen 8080;

    location = /_grafana-auth {
        internal;
        proxy_pass http://grafana:3000/api/user;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "grafana_session=$cookie_grafana_session";
    }

    location = /dart-api {
        return 308 /dart-api/;
    }

    location /dart-api/ {
        auth_request /_grafana-auth;
        proxy_pass http://orchestrator:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer ${DART_ORCHESTRATOR_BEARER_TOKEN}";
        proxy_set_header Idempotency-Key $dart_idempotency_key;
        proxy_set_header Cookie "";
    }

    location / {
        proxy_pass http://grafana:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $dart_connection_upgrade;
    }
}
