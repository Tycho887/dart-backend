        "sync": true,
        "update": {
          "code": "const response = context.panel.response;\nif (!response || typeof response.json !== 'function') {\n  context.grafana.notifyError(['Pipeline', 'The gateway returned an unreadable response.']);\n  return;\n}\n\nreturn response.json()\n  .then((body) => {\n    if (!response.ok) {\n      context.grafana.notifyError([\n        'Pipeline',\n        body.detail ?? `Request failed with HTTP ${response.status}.`,\n      ]);\n      return;\n    }\n    context.grafana.notifySuccess([\n      'Pipeline queued',\n      `Run ${body.run_id} was accepted. Refresh the result tables to follow it.`,\n    ]);\n    context.grafana.refresh();\n  })\n  .catch((error) => {\n    context.grafana.notifyError([\n      'Pipeline',\n      `Could not read the gateway response: ${error.message ?? error}`,\n    ]);\n  });",
          "confirm": false,
          "contentType": "application/json",
          "getPayload": "const elements = Object.fromEntries(\n  context.panel.elements.map((element) => [element.id, element.value])\n);\nconst text = (id) => String(elements[id] ?? '').trim();\nconst requiredNumber = (id) => {\n  const value = elements[id];\n  if (value === null || value === undefined || value === '') {\n    throw new Error(`Missing required number: ${id}`);\n  }\n  const parsed = Number(value);\n  if (!Number.isFinite(parsed)) {\n    throw new Error(`Invalid number: ${id}`);\n  }\n  return parsed;\n};\nconst selected = (id) => {\n  const value = elements[id];\n  if (Array.isArray(value)) {\n    return value.map(String);\n  }\n  if (value === null || value === undefined || value === '') {\n    return [];\n  }\n  return [String(value)];\n};\nconst checked = (id) => selected(id).length > 0;\nconst contactIds = text('contact_ids').split(/[,\\s]+/).filter(Boolean);\nconst spacecraftId = text('spacecraft_id');\nconst startTime = text('start_time');\nconst endTime = text('end_time');\nconst query = {\n  contact_ids: contactIds,\n  require_lock: checked('require_lock'),\n  minimum_elevation_deg: requiredNumber('minimum_elevation_deg'),\n  minimum_ebn0_db: requiredNumber('minimum_ebn0_db'),\n  minimum_doppler_hz: requiredNumber('minimum_doppler_hz'),\n  maximum_doppler_hz: requiredNumber('maximum_doppler_hz'),\n};\nif (query.minimum_doppler_hz >= query.maximum_doppler_hz) {\n  throw new Error('Minimum Doppler must be lower than Maximum Doppler.');\n}\nif (contactIds.length === 0) {\n  query.spacecraft_id = spacecraftId;\n  query.start_time = startTime;\n  query.end_time = endTime;\n}\nconst required = [\n  ['spacecraft_id', spacecraftId],\n  ['reference_tle_name', text('reference_tle_name')],\n  ['reference_tle_line1', text('reference_tle_line1')],\n  ['reference_tle_line2', text('reference_tle_line2')],\n];\nconst missing = required.filter(([, value]) => !value).map(([id]) => id);\nif (contactIds.length === 0 && (!spacecraftId || !startTime || !endTime)) {\n  missing.push('contact IDs or spacecraft ID with start and end times');\n}\nconst nominalCarrierFrequencyHz = requiredNumber('nominal_carrier_frequency_hz');\nconst dopplerStandardDeviationHz = requiredNumber('doppler_standard_deviation_hz');\nconst robustScaleHz = requiredNumber('robust_scale_hz');\nconst qmcSamples = requiredNumber('qmc_samples');\nif (!(nominalCarrierFrequencyHz > 0)) {\n  missing.push('nominal_carrier_frequency_hz');\n}\nif (!(dopplerStandardDeviationHz > 0)) {\n  missing.push('doppler_standard_deviation_hz');\n}\nif (!(robustScaleHz > 0)) {\n  missing.push('robust_scale_hz');\n}\nif (!Number.isInteger(qmcSamples) || qmcSamples < 0 || qmcSamples > 4096) {\n  missing.push('qmc_samples (integer from 0 to 4096)');\n}\nif (missing.length > 0) {\n  throw new Error(`Missing or invalid input: ${missing.join(', ')}`);\n}\nconst orderedModels = [\n  'time_offset',\n  'time_offset_pass_bias',\n  'time_offset_frequency_pass_bias',\n  'mean_elements_two_parameter',\n];\nconst requestedModels = selected('candidate_models');\nconst candidateMetaparameters = orderedModels\n  .filter((model) => requestedModels.includes(model))\n  .map((model) => ({\n    model,\n    doppler_standard_deviation_hz: dopplerStandardDeviationHz,\n    robust_loss: text('robust_loss'),\n    robust_scale_hz: robustScaleHz,\n    qmc_samples: qmcSamples,\n  }));\nif (candidateMetaparameters.length === 0) {\n  throw new Error('Select at least one candidate model.');\n}\nreturn {\n  schema_version: '0.1',\n  pipeline: 'batch_od',\n  query,\n  optimizer_configuration: {\n    reference_tle: {\n      name: text('reference_tle_name'),\n      line1: text('reference_tle_line1'),\n      line2: text('reference_tle_line2'),\n    },\n    spacecraft_id: spacecraftId,\n    nominal_carrier_frequency_hz: nominalCarrierFrequencyHz,\n  },\n  candidate_metaparameters: candidateMetaparameters,\n  selection_criterion: text('selection_criterion'),\n};",
          "header": [],
          "method": "POST",
          "payload": {},
          "payloadMode": "custom",
