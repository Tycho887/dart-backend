          "sync": true,
          "update": {
            "code": "const response = context.panel.response;\nif (!response || typeof response.json !== 'function') {\n  context.grafana.notifyError(['Metadata lookup', 'The server returned an unreadable response.']);\n  return;\n}\n\nreturn response.json()\n  .then((values) => {\n    if (!response.ok) {\n      context.grafana.notifyError([\n        'Metadata lookup',\n        values.detail ?? `Request failed with HTTP ${response.status}.`,\n      ]);\n      return;\n    }\n    if (!values || typeof values !== 'object' || Array.isArray(values)) {\n      context.grafana.notifyError(['Metadata lookup', 'The server returned no metadata.']);\n      return;\n    }\n\n    context.panel.onChangeElements(\n      context.panel.elements.map((element) => {\n        if (element.id.startsWith('lookup_')) {\n          return element;\n        }\n        return {\n          ...element,\n          value: values[element.id] ?? '',\n        };\n      })\n    );\n    context.grafana.notifySuccess(['Metadata lookup', 'Metadata loaded successfully.']);\n  })\n  .catch((error) => {\n    context.grafana.notifyError([\n      'Metadata lookup',\n      `Could not read the server response: ${error.message ?? error}`,\n    ]);\n  });",
            "confirm": false,
            "contentType": "application/json",
            "getPayload": "const input = context.panel.elements.find((element) => element.id === 'lookup_contact_id');\nconst value = String(input?.value ?? '').trim();\nreturn { contact_id: value };",
            "header": [],
            "method": "POST",
            "payload": {},
            "payloadMode": "custom",
            "url": "/dart-api/v0/metadata/contact"
          },
          "updateEnabled": "auto"
