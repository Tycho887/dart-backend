{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "spacecraft.link.schema.json",
    "type": "object",
    "description": "Spacecraft link",
    "additionalProperties": false,
    "required": ["frequency", "direction", "polarization"],
    "properties": {
        "frequency": {
            "type": "number",
            "description": "Frequency of the link",
            "minimum": 0
        },
        "direction": {
            "type": "string",
            "description": "Direction of the link",
            "enum": [
                "down",
                "up"
            ]
        },
        "polarization": {
            "type": ["string", "null"],
            "description": "Polarization of the link",
            "enum": [
                "LHCP",
                "RHCP",
                null
            ]
        }
    }
}
