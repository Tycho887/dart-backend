                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Bearer authentication failed."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "maxLength": 2000,
                      "minLength": 1,
                      "type": "string"
                    },
                    "instance": {
                      "maxLength": 2000,
                      "type": "string"
                    },
                    "status": {
                      "maximum": 599.0,
                      "minimum": 400.0,
                      "type": "integer"
                    },
                    "title": {
                      "maxLength": 200,
                      "minLength": 1,
