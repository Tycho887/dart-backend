                    },
                    "type": {
                      "enum": [
                        "urn:dart:problem:authentication",
                        "urn:dart:problem:configuration",
                        "urn:dart:problem:conflict",
                        "urn:dart:problem:domain",
                        "urn:dart:problem:internal",
                        "urn:dart:problem:method-not-allowed",
