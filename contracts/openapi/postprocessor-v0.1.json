{
  "components": {
    "schemas": {
      "BatchResult": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "model": {
                  "const": "time_offset"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/components/schemas/TimeOffsetParameters"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "time_offset_pass_bias"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/components/schemas/TimeOffsetPassBiasParameters"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "time_offset_frequency_pass_bias"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/components/schemas/TimeOffsetFrequencyPassBiasParameters"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "mean_elements_two_parameter"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/components/schemas/MeanElementsTwoParameterParameters"
                }
              }
            }
          }
        ],
        "properties": {
          "consumed_channels": {
            "items": {
              "$ref": "#/components/schemas/ObservableChannel"
            },
            "minItems": 1,
            "title": "Consumed Channels",
            "type": "array"
          },
          "corrected_tle": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TLEData"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "covariance": {
            "$ref": "#/components/schemas/Covariance"
          },
          "diagnostics": {
            "$ref": "#/components/schemas/FitDiagnostics"
          },
          "effective_carrier_frequency_hz": {
            "exclusiveMinimum": 0.0,
            "title": "Effective Carrier Frequency Hz",
            "type": "number"
          },
          "model": {
            "$ref": "#/components/schemas/OptimizerModel"
          },
          "parameters": {
            "discriminator": {
              "mapping": {
                "mean_elements_two_parameter": "#/$defs/MeanElementsTwoParameterParameters",
                "time_offset": "#/$defs/TimeOffsetParameters",
                "time_offset_frequency_pass_bias": "#/$defs/TimeOffsetFrequencyPassBiasParameters",
                "time_offset_pass_bias": "#/$defs/TimeOffsetPassBiasParameters"
              },
              "propertyName": "model"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/TimeOffsetParameters"
              },
              {
                "$ref": "#/components/schemas/TimeOffsetPassBiasParameters"
              },
              {
                "$ref": "#/components/schemas/TimeOffsetFrequencyPassBiasParameters"
              },
              {
                "$ref": "#/components/schemas/MeanElementsTwoParameterParameters"
              }
            ],
            "title": "Parameters"
          },
          "pass_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Pass Ids",
            "type": "array"
          },
          "reference_tle": {
            "$ref": "#/components/schemas/TLEData"
          },
          "residuals": {
            "items": {
              "$ref": "#/components/schemas/ResidualRecord"
            },
            "minItems": 1,
            "title": "Residuals",
            "type": "array"
          },
          "schema_version": {
            "const": "0.1",
            "default": "0.1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "model",
          "effective_carrier_frequency_hz",
          "reference_tle",
          "parameters",
          "covariance",
          "residuals",
          "diagnostics",
          "consumed_channels",
          "pass_ids"
        ],
        "title": "BatchResult",
        "type": "object"
      },
      "Covariance": {
        "additionalProperties": false,
        "properties": {
          "matrix": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "minItems": 1,
            "title": "Matrix",
            "type": "array"
          },
          "parameter_order": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Parameter Order",
            "type": "array"
          }
        },
        "required": [
          "parameter_order",
          "matrix"
        ],
        "title": "Covariance",
        "type": "object"
      },
      "EvidenceClass": {
        "enum": [
          "residual_only",
          "reference_ephemeris"
        ],
        "title": "EvidenceClass",
        "type": "string"
      },
      "FitDiagnostics": {
        "additionalProperties": false,
        "properties": {
          "at_bound": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "At Bound"
          },
          "healthy": {
            "title": "Healthy",
            "type": "boolean"
          },
          "jacobian_condition": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Jacobian Condition"
          },
          "jacobian_rank": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Jacobian Rank"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "observations_used": {
            "minimum": 0,
            "title": "Observations Used",
            "type": "integer"
          },
          "robust_cost": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Robust Cost"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "weighted_ssr": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Weighted Ssr"
          }
        },
        "required": [
          "success",
          "healthy",
          "message",
          "observations_used"
        ],
        "title": "FitDiagnostics",
        "type": "object"
      },
      "InformationCriterion": {
        "enum": [
          "bic",
          "aic",
          "aicc"
        ],
        "title": "InformationCriterion",
        "type": "string"
      },
      "MeanElementsTwoParameterParameters": {
        "additionalProperties": false,
        "properties": {
          "mean_anomaly_rad": {
            "title": "Mean Anomaly Rad",
            "type": "number"
          },
          "mean_motion_rad_min": {
            "exclusiveMinimum": 0.0,
            "title": "Mean Motion Rad Min",
            "type": "number"
          },
          "model": {
            "const": "mean_elements_two_parameter",
            "default": "mean_elements_two_parameter",
            "title": "Model",
            "type": "string"
          },
          "pass_biases": {
            "items": {
              "$ref": "#/components/schemas/PassDopplerBias"
            },
            "minItems": 1,
            "title": "Pass Biases",
            "type": "array"
          }
        },
        "required": [
          "mean_anomaly_rad",
          "mean_motion_rad_min",
          "pass_biases"
        ],
        "title": "MeanElementsTwoParameterParameters",
        "type": "object"
      },
      "MetricGroup": {
        "additionalProperties": false,
        "properties": {
          "metrics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Metrics",
            "type": "object"
          }
        },
        "required": [
          "metrics"
        ],
        "title": "MetricGroup",
        "type": "object"
      },
      "ObservableChannel": {
        "enum": [
          "doppler"
        ],
        "title": "ObservableChannel",
        "type": "string"
      },
      "ObservableResidual": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/ObservableChannel"
          },
          "consumed": {
            "title": "Consumed",
            "type": "boolean"
          },
          "predicted": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Predicted"
          },
          "residual": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Residual"
          },
          "robust_weight": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Robust Weight"
          }
        },
        "required": [
          "channel",
          "consumed"
        ],
        "title": "ObservableResidual",
        "type": "object"
      },
      "OemDocument": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "encoding": {
            "$ref": "#/components/schemas/OemEncoding"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "encoding",
          "content",
          "sha256"
        ],
        "title": "OemDocument",
        "type": "object"
      },
      "OemEncoding": {
        "enum": [
          "kvn",
          "xml"
        ],
        "title": "OemEncoding",
        "type": "string"
      },
      "OptimizerModel": {
        "description": "One concrete production forward model selected by an optimizer request.",
        "enum": [
          "time_offset",
          "time_offset_pass_bias",
          "time_offset_frequency_pass_bias",
          "mean_elements_two_parameter"
        ],
        "title": "OptimizerModel",
        "type": "string"
      },
      "PassDopplerBias": {
        "additionalProperties": false,
        "properties": {
          "bias_hz": {
            "title": "Bias Hz",
            "type": "number"
          },
          "pass_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Pass Id",
            "type": "string"
          }
        },
        "required": [
          "pass_id",
          "bias_hz"
        ],
        "title": "PassDopplerBias",
        "type": "object"
      },
      "QualityRequest": {
        "additionalProperties": false,
        "properties": {
          "reference_oem": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OemDocument"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "result": {
            "$ref": "#/components/schemas/BatchResult"
          },
          "schema_version": {
            "const": "0.1",
            "default": "0.1",
            "title": "Schema Version",
            "type": "string"
          },
          "selection_criterion": {
            "$ref": "#/components/schemas/InformationCriterion"
          }
        },
        "required": [
          "result",
          "selection_criterion"
        ],
        "title": "QualityRequest",
        "type": "object"
      },
      "QualityResult": {
        "additionalProperties": false,
        "properties": {
          "convergence": {
            "$ref": "#/components/schemas/MetricGroup"
          },
          "evidence_class": {
            "$ref": "#/components/schemas/EvidenceClass"
          },
          "residuals": {
            "$ref": "#/components/schemas/MetricGroup"
          },
          "schema_version": {
            "const": "0.1",
            "default": "0.1",
            "title": "Schema Version",
            "type": "string"
          },
          "selection": {
            "$ref": "#/components/schemas/SelectionScore"
          },
          "truth": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetricGroup"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "evidence_class",
          "convergence",
          "residuals",
          "selection"
        ],
        "title": "QualityResult",
        "type": "object"
      },
      "ResidualRecord": {
        "additionalProperties": false,
        "properties": {
          "channels": {
            "items": {
              "$ref": "#/components/schemas/ObservableResidual"
            },
            "minItems": 1,
            "title": "Channels",
            "type": "array"
          },
          "measurement_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Measurement Id",
            "type": "string"
          }
        },
        "required": [
          "measurement_id",
          "channels"
        ],
        "title": "ResidualRecord",
        "type": "object"
      },
      "SelectionScore": {
        "additionalProperties": false,
        "description": "Comparable information-criterion score for one candidate fit.",
        "properties": {
          "criterion": {
            "$ref": "#/components/schemas/InformationCriterion"
          },
          "eligible": {
            "title": "Eligible",
            "type": "boolean"
          },
          "fitted_parameter_count": {
            "minimum": 1,
            "title": "Fitted Parameter Count",
            "type": "integer"
          },
          "observations": {
            "minimum": 0,
            "title": "Observations",
            "type": "integer"
          },
          "residual_sum_squares_hz2": {
            "minimum": 0.0,
            "title": "Residual Sum Squares Hz2",
            "type": "number"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Score"
          }
        },
        "required": [
          "criterion",
          "eligible",
          "observations",
          "fitted_parameter_count",
          "residual_sum_squares_hz2"
        ],
        "title": "SelectionScore",
        "type": "object"
      },
      "TLEData": {
        "additionalProperties": false,
        "properties": {
          "line1": {
            "maxLength": 100,
            "minLength": 60,
            "title": "Line1",
            "type": "string"
          },
          "line2": {
            "maxLength": 100,
            "minLength": 60,
            "title": "Line2",
            "type": "string"
          },
          "name": {
            "default": "DART-OBJECT",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "line1",
          "line2"
        ],
        "title": "TLEData",
        "type": "object"
      },
      "TimeOffsetFrequencyPassBiasParameters": {
        "additionalProperties": false,
        "properties": {
          "center_frequency_correction_hz": {
            "title": "Center Frequency Correction Hz",
            "type": "number"
          },
          "model": {
            "const": "time_offset_frequency_pass_bias",
            "default": "time_offset_frequency_pass_bias",
            "title": "Model",
            "type": "string"
          },
          "pass_biases": {
            "items": {
              "$ref": "#/components/schemas/PassDopplerBias"
            },
            "minItems": 1,
            "title": "Pass Biases",
            "type": "array"
          },
          "time_offset_s": {
            "title": "Time Offset S",
            "type": "number"
          }
        },
        "required": [
          "time_offset_s",
          "center_frequency_correction_hz",
          "pass_biases"
        ],
        "title": "TimeOffsetFrequencyPassBiasParameters",
        "type": "object"
      },
      "TimeOffsetParameters": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "const": "time_offset",
            "default": "time_offset",
            "title": "Model",
            "type": "string"
          },
          "time_offset_s": {
            "title": "Time Offset S",
            "type": "number"
          }
        },
        "required": [
          "time_offset_s"
        ],
        "title": "TimeOffsetParameters",
        "type": "object"
      },
      "TimeOffsetPassBiasParameters": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "const": "time_offset_pass_bias",
            "default": "time_offset_pass_bias",
            "title": "Model",
            "type": "string"
          },
          "pass_biases": {
            "items": {
              "$ref": "#/components/schemas/PassDopplerBias"
            },
            "minItems": 1,
            "title": "Pass Biases",
            "type": "array"
          },
          "time_offset_s": {
            "title": "Time Offset S",
            "type": "number"
          }
        },
        "required": [
          "time_offset_s",
          "pass_biases"
        ],
        "title": "TimeOffsetPassBiasParameters",
        "type": "object"
      }
    },
    "securitySchemes": {
      "InternalBearer": {
        "bearerFormat": "opaque",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "DART Postprocessor",
    "version": "0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
