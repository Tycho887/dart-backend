{
  "components": {
    "schemas": {
      "BatchRequest": {
        "additionalProperties": false,
        "properties": {
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/Measurement"
            },
            "minItems": 1,
            "title": "Measurements",
            "type": "array"
          },
          "optimizer_data": {
            "$ref": "#/components/schemas/OptimizerData"
          },
          "schema_version": {
            "const": "0.1",
            "default": "0.1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "measurements",
          "optimizer_data"
        ],
        "title": "BatchRequest",
        "type": "object"
      },
      "BatchResult": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "model": {
                  "const": "time_offset"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/components/schemas/TimeOffsetParameters"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "time_offset_pass_bias"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/components/schemas/TimeOffsetPassBiasParameters"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "time_offset_frequency_pass_bias"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/components/schemas/TimeOffsetFrequencyPassBiasParameters"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "mean_elements_two_parameter"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/components/schemas/MeanElementsTwoParameterParameters"
                }
              }
            }
          }
        ],
        "properties": {
          "consumed_channels": {
            "items": {
              "$ref": "#/components/schemas/ObservableChannel"
            },
            "minItems": 1,
            "title": "Consumed Channels",
            "type": "array"
          },
          "corrected_tle": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TLEData"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "covariance": {
            "$ref": "#/components/schemas/Covariance"
          },
          "diagnostics": {
            "$ref": "#/components/schemas/FitDiagnostics"
          },
          "effective_carrier_frequency_hz": {
            "exclusiveMinimum": 0.0,
            "title": "Effective Carrier Frequency Hz",
            "type": "number"
          },
          "model": {
            "$ref": "#/components/schemas/OptimizerModel"
          },
          "parameters": {
            "discriminator": {
              "mapping": {
                "mean_elements_two_parameter": "#/$defs/MeanElementsTwoParameterParameters",
                "time_offset": "#/$defs/TimeOffsetParameters",
                "time_offset_frequency_pass_bias": "#/$defs/TimeOffsetFrequencyPassBiasParameters",
                "time_offset_pass_bias": "#/$defs/TimeOffsetPassBiasParameters"
              },
              "propertyName": "model"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/TimeOffsetParameters"
              },
              {
                "$ref": "#/components/schemas/TimeOffsetPassBiasParameters"
              },
              {
                "$ref": "#/components/schemas/TimeOffsetFrequencyPassBiasParameters"
              },
              {
                "$ref": "#/components/schemas/MeanElementsTwoParameterParameters"
              }
            ],
            "title": "Parameters"
          },
          "pass_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Pass Ids",
            "type": "array"
          },
          "reference_tle": {
            "$ref": "#/components/schemas/TLEData"
          },
          "residuals": {
            "items": {
              "$ref": "#/components/schemas/ResidualRecord"
            },
            "minItems": 1,
            "title": "Residuals",
            "type": "array"
          },
          "schema_version": {
            "const": "0.1",
            "default": "0.1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "model",
          "effective_carrier_frequency_hz",
          "reference_tle",
          "parameters",
          "covariance",
          "residuals",
          "diagnostics",
          "consumed_channels",
          "pass_ids"
        ],
        "title": "BatchResult",
        "type": "object"
      },
      "Cartesian3": {
        "additionalProperties": false,
        "properties": {
          "x": {
            "title": "X",
