          }
        },
        "required": [
          "parameter_order",
          "matrix"
        ],
        "title": "Covariance",
        "type": "object"
      },
      "FitDiagnostics": {
        "additionalProperties": false,
        "properties": {
          "at_bound": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "At Bound"
          },
          "healthy": {
            "title": "Healthy",
            "type": "boolean"
          },
          "jacobian_condition": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Jacobian Condition"
          },
          "jacobian_rank": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Jacobian Rank"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "observations_used": {
            "minimum": 0,
            "title": "Observations Used",
            "type": "integer"
          },
          "robust_cost": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Robust Cost"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "weighted_ssr": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Weighted Ssr"
          }
        },
        "required": [
          "success",
          "healthy",
          "message",
          "observations_used"
        ],
        "title": "FitDiagnostics",
        "type": "object"
      },
      "MeanElementsTwoParameterMetaparameters": {
        "additionalProperties": false,
        "description": "Metaparameters for mean anomaly, mean motion, and pass biases.",
        "properties": {
          "doppler_standard_deviation_hz": {
            "default": 500.0,
            "exclusiveMinimum": 0.0,
            "title": "Doppler Standard Deviation Hz",
            "type": "number"
          },
          "mean_anomaly_half_width_rad": {
            "default": 0.5,
            "exclusiveMinimum": 0.0,
            "title": "Mean Anomaly Half Width Rad",
            "type": "number"
          },
          "mean_motion_half_width_rad_min": {
            "default": 0.002,
            "exclusiveMinimum": 0.0,
            "title": "Mean Motion Half Width Rad Min",
            "type": "number"
          },
          "model": {
            "const": "mean_elements_two_parameter",
            "title": "Model",
            "type": "string"
          },
          "pass_bias_bounds_hz": {
            "default": [
              -100000.0,
              100000.0
            ],
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "title": "Pass Bias Bounds Hz",
            "type": "array"
          },
          "qmc_samples": {
            "default": 64,
            "maximum": 4096,
            "minimum": 0,
            "title": "Qmc Samples",
            "type": "integer"
          },
          "robust_loss": {
            "default": "cauchy",
            "enum": [
              "linear",
              "soft_l1",
              "huber",
              "cauchy",
              "arctan"
            ],
            "title": "Robust Loss",
            "type": "string"
          },
          "robust_scale_hz": {
            "default": 500.0,
            "exclusiveMinimum": 0.0,
            "title": "Robust Scale Hz",
            "type": "number"
          }
        },
        "required": [
          "model"
        ],
        "title": "MeanElementsTwoParameterMetaparameters",
        "type": "object"
      },
      "MeanElementsTwoParameterParameters": {
        "additionalProperties": false,
        "properties": {
          "mean_anomaly_rad": {
            "title": "Mean Anomaly Rad",
            "type": "number"
          },
          "mean_motion_rad_min": {
            "exclusiveMinimum": 0.0,
            "title": "Mean Motion Rad Min",
            "type": "number"
          },
          "model": {
